CC = gcc
CFLAGS = -Wall -g

TARGET_SERVER = server
SOURCE_SERVER = tcpFileServer.c

TARGET_CLIENT = client
SOURCE_CLIENT = tcpFileClient.c

TARGET_FILE_GEN = filegen 
SOURCE_FILE_GEN = 100mbfilegeneration.c

all: $(TARGET_SERVER) $(TARGET_CLIENT) $(TARGET_FILE_GEN)

$(TARGET_SERVER): $(SOURCE_SERVER)
	$(CC) $(CFLAGS) -o $(TARGET_SERVER) $(SOURCE_SERVER)

$(TARGET_CLIENT): $(SOURCE_CLIENT)
	$(CC) $(CFLAGS) -o $(TARGET_CLIENT) $(SOURCE_CLIENT)

$(TARGET_FILE_GEN): $(SOURCE_FILE_GEN)
	$(CC) $(CFLAGS) -o $(TARGET_FILE_GEN) $(SOURCE_FILE_GEN)
clean:
	rm -f $(TARGET_SERVER) $(TARGET_CLIENT) $(TARGET_FILE_GEN)